# ---- required ----
LISTEN_ADDR=:8080
API_KEY=replace-with-openssl-rand-hex-32
CARD_NUMBER=6037-0000-0000-0000
CARD_HOLDER=نام صاحب کارت

# ---- recommended ----
WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
DEFAULT_EXPIRY=15m

# ---- storage ----
DB_PATH=/data/bluey.db

# ---- BluBank web adapter ----
# The server must be able to reach https://app.blubank.com (use an Iranian VPS).
BLUBANK_ENABLED=true
BLUBANK_USERNAME=your-blubank-username
BLUBANK_PASSWORD=your-blubank-password
BLUBANK_PROFILE_DIR=/data/blubank-profile
# Defaults to <BLUBANK_PROFILE_DIR>/session.json. Contains a sensitive session token; keep it private.
# BLUBANK_STATE_PATH=/data/blubank-profile/session.json
BLUBANK_CHROME_PATH=/usr/bin/chromium
BLUBANK_POLL_INTERVAL=15s
# BLUBANK_PROXY=socks5://127.0.0.1:1080

# Allow webhook callbacks to localhost/private IPs. Keep false in production.
ALLOW_PRIVATE_CALLBACKS=false
